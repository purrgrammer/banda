{
	"name": "banda",
	"version": "0.1.0-alpha.4",
	"private": true,
	"description": "A band of personal agents.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/purrgrammer/banda.git"
	},
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"bin": {
		"banda": "./dist/cli/index.js"
	},
	"scripts": {
		"eval:journeys": "node scripts/journeys.ts",
		"home:fork": "node scripts/fork-home.ts",
		"build": "tsc -p tsconfig.json && npm run build:web",
		"build:web": "vite build web",
		"build:site": "vite build site --outDir ../dist/site --emptyOutDir",
		"site:dev": "vite --open /site/",
		"site:band": "node scripts/band-picture.ts",
		"site:og": "\"${CHROME:-/Applications/Google Chrome.app/Contents/MacOS/Google Chrome}\" --headless=new --hide-scrollbars --window-size=1200,630 --virtual-time-budget=5000 --screenshot=site/public/og.png \"file://$PWD/site/og.html\"",
		"web:dev": "vite web",
		"web:contrast": "node web/scripts/contrast.mjs",
		"boxes:sweep": "node scripts/sweep-boxes.ts",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p web/tsconfig.json",
		"test": "vitest run --project unit",
		"test:fast": "vitest run --project unit",
		"test:faults": "vitest run --project faults",
		"test:docker": "vitest run --project docker",
		"test:pbt": "BANDA_PBT_RUNS=20 vitest run --project unit",
		"check": "biome check .",
		"fix": "biome check --write .",
		"cli:pack": "npm run build && node scripts/stage.ts --archive",
		"desktop:dev": "npm run build && npm --prefix desktop run build && BANDA_HOME=${BANDA_HOME:-$(mktemp -d)} BANDA_PORT=${BANDA_PORT:-0} npm --prefix desktop exec electron desktop",
		"desktop:pack": "npm run build && node scripts/stage.ts && npm --prefix desktop ci && npm --prefix desktop run dist",
		"mobile:apk": "npm run build:web && npm --prefix mobile ci && npm --prefix mobile run apk",
		"mobile:apk:release": "npm run build:web && npm --prefix mobile ci && npm --prefix mobile run apk:release",
		"mobile:install": "npm --prefix mobile run install:debug",
		"mobile:test": "npm --prefix mobile test"
	},
	"dependencies": {
		"@earendil-works/chord": "1.4.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-durable": "1.4.0",
		"@earendil-works/pi-env": "1.4.0",
		"@earendil-works/pi-mcp": "1.4.0",
		"@number0/iroh": "1.2.0",
		"@resvg/resvg-js": "2.6.2",
		"motion": "14.5.0",
		"open-bot-avatar": "0.1.2",
		"react-medium-image-zoom": "5.4.9",
		"typebox": "1.3.27",
		"use-stick-to-bottom": "1.1.6"
	},
	"devDependencies": {
		"@agentclientprotocol/claude-agent-acp": "0.100.0",
		"@agentclientprotocol/codex-acp": "2.5.0",
		"@biomejs/biome": "2.5.15",
		"@fontsource-variable/geist": "5.3.0",
		"@fontsource-variable/geist-mono": "5.3.0",
		"@radix-ui/react-use-controllable-state": "1.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "5.2.0",
		"axe-core": "4.14.0",
		"class-variance-authority": "0.7.1",
		"cmdk": "1.1.1",
		"cn": "0.5.0",
		"emojibase-data": "18.0.0",
		"fast-check": "4.10.2",
		"frimousse": "0.4.0",
		"lucide-react": "1.61.0",
		"radix-ui": "1.8.1",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"shiki": "4.5.0",
		"sonner": "2.0.8",
		"streamdown": "2.7.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.3",
		"uqr": "0.1.3",
		"vite": "7.3.7",
		"vitest": "4.1.12"
	}
}
