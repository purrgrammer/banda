{
	"service": "Google Drive",
	"about": "Find and read your files",
	"url": "https://www.googleapis.com/drive/v3",
	"api": "drive",
	"auth": "oauth",
	"client": "google",
	"scopes": [
		"https://www.googleapis.com/auth/drive.readonly"
	],
	"access": {
		"required": "Find and read your files, including Docs and Sheets",
		"choices": [
			{
				"label": "Create files",
				"scopes": [
					"https://www.googleapis.com/auth/drive.file"
				]
			},
			{
				"label": "Change your spreadsheets",
				"scopes": [
					"https://www.googleapis.com/auth/spreadsheets"
				]
			},
			{
				"label": "Change your documents",
				"scopes": [
					"https://www.googleapis.com/auth/documents"
				]
			},
			{
				"label": "Change any of your files",
				"scopes": [
					"https://www.googleapis.com/auth/drive"
				]
			}
		],
		"note": "Changing access signs in again. Every change (creating, replacing or adding to a Doc's text, renaming and trashing files, a Sheet's rows, cells and tabs, a reply to a comment) still asks you to approve it; banda never shares a file or deletes one for good."
	},
	"account": "get_profile.email",
	"reads": [
		"get_profile",
		"search_files",
		"get_file",
		"read_file",
		"list_comments"
	],
	"needs": {
		"create_doc": [
			"https://www.googleapis.com/auth/drive.file",
			"https://www.googleapis.com/auth/drive"
		],
		"create_sheet": [
			"https://www.googleapis.com/auth/drive.file",
			"https://www.googleapis.com/auth/drive"
		],
		"replace_doc_text": [
			"https://www.googleapis.com/auth/drive.file",
			"https://www.googleapis.com/auth/drive"
		],
		"rename_file": [
			"https://www.googleapis.com/auth/drive.file",
			"https://www.googleapis.com/auth/drive"
		],
		"trash_file": [
			"https://www.googleapis.com/auth/drive.file",
			"https://www.googleapis.com/auth/drive"
		],
		"append_rows": [
			"https://www.googleapis.com/auth/spreadsheets",
			"https://www.googleapis.com/auth/drive.file",
			"https://www.googleapis.com/auth/drive"
		],
		"update_range": [
			"https://www.googleapis.com/auth/spreadsheets",
			"https://www.googleapis.com/auth/drive.file",
			"https://www.googleapis.com/auth/drive"
		],
		"add_sheet": [
			"https://www.googleapis.com/auth/spreadsheets",
			"https://www.googleapis.com/auth/drive.file",
			"https://www.googleapis.com/auth/drive"
		],
		"append_doc_text": [
			"https://www.googleapis.com/auth/documents",
			"https://www.googleapis.com/auth/drive.file",
			"https://www.googleapis.com/auth/drive"
		],
		"reply_comment": [
			"https://www.googleapis.com/auth/drive.file",
			"https://www.googleapis.com/auth/drive"
		]
	},
	"objects": {
		"file": {
			"card": "file",
			"name": "{id}",
			"urls": [
				"https://docs.google.com/document/d/{id}",
				"https://docs.google.com/spreadsheets/d/{id}",
				"https://docs.google.com/presentation/d/{id}",
				"https://docs.google.com/document/u/*/d/{id}",
				"https://docs.google.com/spreadsheets/u/*/d/{id}",
				"https://docs.google.com/presentation/u/*/d/{id}",
				"https://drive.google.com/file/d/{id}",
				"https://drive.google.com/file/u/*/d/{id}"
			],
			"ids": [
				"drive/{id}"
			],
			"reads": {
				"file": {
					"tool": "get_file",
					"args": {
						"file_id": "{id}"
					}
				}
			},
			"follow": {
				"authors": {
					"file": "modifier.email"
				},
				"rules": [
					{
						"on": "file.trashed",
						"to": true,
						"does": "wake",
						"says": "trashed"
					},
					{
						"on": "file.modified",
						"does": "wake",
						"says": "{modifier.name} edited it"
					},
					{
						"on": "file.name",
						"does": "tell",
						"says": "renamed: {to}"
					},
					{
						"on": "file.parents[*]",
						"does": "tell",
						"says": "moved"
					},
					{
						"on": "file.shared[*]",
						"kind": "added",
						"does": "tell",
						"says": "shared with {who}"
					}
				],
				"ends": {
					"trashed": "file.trashed = true"
				},
				"every": "10m",
				"settle": "10m"
			},
			"fields": {
				"name": "file.name",
				"kind": "file.kind",
				"mime_type": "file.mimeType",
				"owner": "file.owner",
				"modified": "file.modified",
				"size": "file.size",
				"description": "file.description",
				"url": "file.url"
			},
			"writes": [
				{
					"tool": "replace_doc_text",
					"id": {
						"id": "file_id"
					},
					"verb": "Replace"
				},
				{
					"tool": "rename_file",
					"id": {
						"id": "file_id"
					},
					"verb": "Rename"
				},
				{
					"tool": "trash_file",
					"id": {
						"id": "file_id"
					},
					"verb": "Trash"
				},
				{
					"tool": "append_rows",
					"id": {
						"id": "file_id"
					},
					"verb": "Add"
				},
				{
					"tool": "update_range",
					"id": {
						"id": "file_id"
					},
					"verb": "Write"
				},
				{
					"tool": "add_sheet",
					"id": {
						"id": "file_id"
					},
					"verb": "Add"
				},
				{
					"tool": "append_doc_text",
					"id": {
						"id": "file_id"
					},
					"verb": "Add"
				},
				{
					"tool": "reply_comment",
					"id": {
						"id": "file_id"
					},
					"verb": "Reply"
				}
			]
		},
		"folder": {
			"card": "file",
			"name": "folder {id}",
			"urls": [
				"https://drive.google.com/drive/folders/{id}",
				"https://drive.google.com/drive/u/*/folders/{id}"
			],
			"ids": [
				"drive/folder/{id}"
			],
			"reads": {
				"file": {
					"tool": "get_file",
					"args": {
						"file_id": "{id}"
					}
				},
				"files": {
					"follow": true,
					"tool": "search_files",
					"args": {
						"query": "'{id}' in parents",
						"order": "created",
						"max_results": 50
					}
				}
			},
			"follow": {
				"keys": {
					"files.files": "ref"
				},
				"authors": {
					"file": "modifier.email"
				},
				"rules": [
					{
						"on": "file.trashed",
						"to": true,
						"does": "wake",
						"says": "trashed"
					},
					{
						"on": "files.files[*]",
						"kind": "added",
						"does": "wake",
						"says": "new file: {name}"
					},
					{
						"on": "file.name",
						"does": "tell",
						"says": "renamed: {to}"
					},
					{
						"on": "file.parents[*]",
						"does": "tell",
						"says": "moved"
					},
					{
						"on": "file.shared[*]",
						"kind": "added",
						"does": "tell",
						"says": "shared with {who}"
					}
				],
				"ends": {
					"trashed": "file.trashed = true"
				},
				"every": "10m",
				"settle": "10m"
			},
			"fields": {
				"name": "file.name",
				"kind": "file.kind",
				"mime_type": "file.mimeType",
				"owner": "file.owner",
				"modified": "file.modified",
				"size": "file.size",
				"description": "file.description",
				"url": "file.url"
			}
		}
	}
}
