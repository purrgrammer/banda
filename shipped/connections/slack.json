{
	"service": "Slack",
	"about": "Read channels and threads, and post as you",
	"url": "https://slack.com/api",
	"api": "slack",
	"auth": "oauth",
	"client": "slack",
	"scopes": [
		"channels:read",
		"groups:read",
		"channels:history",
		"groups:history",
		"users:read"
	],
	"access": {
		"required": "Read your channels and who people are",
		"choices": [
			{
				"label": "Direct messages and search",
				"scopes": [
					"im:read",
					"mpim:read",
					"im:history",
					"mpim:history",
					"search:read"
				]
			},
			{
				"label": "Send messages as you",
				"scopes": [
					"chat:write"
				]
			}
		],
		"note": "Changing access signs in again. Every message banda sends as you still asks you to approve it, every time."
	},
	"floors": {
		"private": [
			"post_message"
		]
	},
	"account": "whoami.handle",
	"reads": [
		"whoami",
		"list_channels",
		"get_channel",
		"channel_history",
		"get_thread",
		"search_messages",
		"get_person"
	],
	"needs": {
		"list_channels": [
			"channels:read",
			"groups:read",
			"im:read",
			"mpim:read"
		],
		"get_channel": [
			"channels:read",
			"groups:read",
			"im:read",
			"mpim:read"
		],
		"channel_history": [
			"channels:history",
			"groups:history",
			"im:history",
			"mpim:history"
		],
		"get_thread": [
			"channels:history",
			"groups:history",
			"im:history",
			"mpim:history"
		],
		"search_messages": [
			"search:read"
		],
		"post_message": [
			"chat:write"
		]
	},
	"objects": {
		"thread": {
			"card": "messages",
			"name": "a thread in Slack",
			"normalize": {
				"ts": "slack-ts"
			},
			"urls": [
				"https://*.slack.com/archives/{channel}/p{ts}"
			],
			"ids": [
				"slack/{channel}/p{ts}"
			],
			"reads": {
				"thread": {
					"tool": "get_thread",
					"args": {
						"channel": "{channel}",
						"ts": "{ts}"
					}
				}
			},
			"fields": {
				"channel": "thread.channel_name",
				"root": "thread.root",
				"messages": "thread.messages",
				"total": "thread.total",
				"url": "thread.url"
			},
			"writes": [
				{
					"tool": "post_message",
					"id": {
						"channel": "channel",
						"ts": "thread_ts"
					},
					"verb": "Send",
					"what": "Reply in",
					"text": "text"
				}
			]
		},
		"channel": {
			"card": "messages",
			"name": "a channel in Slack",
			"urls": [
				"https://*.slack.com/archives/{channel}"
			],
			"ids": [
				"slack/{channel}"
			],
			"reads": {
				"channel": {
					"tool": "get_channel",
					"args": {
						"channel": "{channel}"
					}
				},
				"history": {
					"tool": "channel_history",
					"args": {
						"channel": "{channel}"
					}
				}
			},
			"fields": {
				"title": "channel.name",
				"topic": "channel.topic",
				"members": "channel.member_count",
				"messages": "history.messages",
				"url": "history.url"
			},
			"writes": [
				{
					"tool": "post_message",
					"id": {
						"channel": "channel"
					},
					"verb": "Send",
					"what": "Post in",
					"text": "text"
				}
			]
		},
		"search": {
			"card": "messages",
			"name": "{query}",
			"normalize": {
				"query": "text"
			},
			"ids": [
				"slack/search/{query}"
			],
			"reads": {
				"search": {
					"tool": "search_messages",
					"args": {
						"query": "{query}",
						"count": 50,
						"sort": "timestamp",
						"sort_dir": "desc"
					}
				}
			},
			"fields": {
				"messages": "search.messages",
				"total": "search.total"
			}
		},
		"person": {
			"card": "contact",
			"name": "a person in Slack",
			"urls": [
				"https://*.slack.com/team/{user}"
			],
			"ids": [
				"slack/user/{user}"
			],
			"reads": {
				"person": {
					"tool": "get_person",
					"args": {
						"user": "{user}"
					}
				}
			},
			"fields": {
				"name": "person.real_name",
				"handle": "person.name",
				"title": "person.title",
				"emails": "person.email",
				"status": "person.status_text",
				"timezone": "person.tz",
				"outside": "person.outside",
				"url": "person.url"
			}
		}
	}
}
