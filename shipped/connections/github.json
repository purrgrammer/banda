						"method": "get_workflow_job",
						"owner": "{owner}",
						"repo": "{repo}",
						"resource_id": "{job}"
					}
				}
			},
			"follow": {
				"keys": {
					"job.steps": "number"
				},
				"ignore": [
					"job.created_at",
					"job.started_at",
					"job.completed_at",
					"job.runner_id",
					"job.runner_name",
					"job.runner_group_id",
					"job.runner_group_name",
					"job.steps[*].started_at",
					"job.steps[*].completed_at"
				],
				"rules": [
					{
						"on": "job.conclusion",
						"to": "failure",
						"does": "wake",
						"says": "failed"
					},
					{
						"on": "job.conclusion",
						"to": "timed_out",
						"does": "wake",
						"says": "timed out"
					},
					{
						"on": "job.conclusion",
						"to": "cancelled",
						"does": "wake",
						"says": "cancelled"
					},
					{
						"on": "job.conclusion",
						"to": "success",
						"does": "tell",
						"says": "succeeded"
					},
					{
						"on": "job.conclusion",
						"does": "tell",
						"says": "{to}",
						"words": {
							"action_required": "needs action",
							"neutral": "finished neutral",
							"skipped": "skipped",
							"stale": "stale"
						}
					}
				],
				"ends": {
					"completed": "job.status = completed"
				},
				"every": "2m"
			},
			"fields": {
				"name": "job.name",
				"status": "job.status",
				"conclusion": "job.conclusion",
				"steps": "job.steps",
				"started": "job.started_at",
				"completed": "job.completed_at",
				"where": "job.head_branch",
				"url": "job.html_url"
			}
		},
		"workflow_run": {
