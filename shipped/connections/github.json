					"jobs.jobs.jobs[*].started_at",
					"jobs.jobs.jobs[*].completed_at",
					"jobs.jobs.jobs[*].runner_id",
					"jobs.jobs.jobs[*].runner_name",
					"jobs.jobs.jobs[*].runner_group_id",
					"jobs.jobs.jobs[*].runner_group_name"
				],
				"rules": [
					{
						"on": "run.conclusion",
						"to": "failure",
						"does": "wake",
						"says": "failed"
					},
					{
						"on": "run.conclusion",
						"to": "startup_failure",
						"does": "wake",
						"says": "failed to start"
					},
					{
						"on": "run.conclusion",
						"to": "timed_out",
						"does": "wake",
						"says": "timed out"
					},
					{
						"on": "run.conclusion",
						"to": "cancelled",
						"does": "wake",
						"says": "cancelled"
					},
					{
						"on": "run.conclusion",
						"to": "success",
						"does": "tell",
						"says": "succeeded"
					},
					{
						"on": "run.conclusion",
						"does": "tell",
						"says": "{to}",
						"words": {
							"action_required": "needs action",
							"neutral": "finished neutral",
							"skipped": "skipped",
							"stale": "stale"
						}
					},
					{
						"on": "derived.job_failed",
						"to": true,
						"does": "wake",
						"says": "a job failed"
					}
				],
				"ends": {
					"completed": "run.status = completed"
				},
				"every": "2m",
				"settle": "1m"
			},
			"fields": {
				"name": "run.name",
				"status": "run.status",
				"conclusion": "run.conclusion",
				"steps": "jobs.jobs.jobs",
				"started": "run.run_started_at",
				"where": "run.head_branch",
				"url": "run.html_url"
			}
