		"check_run": {
			"card": "check-run",
			"normalize": {
				"owner": "lowercase",
				"repo": "lowercase",
				"job": "integer"
			},
			"name": "{owner}/{repo} · check {job}",
			"urls": [
				"https://github.com/{owner}/{repo}/actions/runs/*/job/{job}",
				"https://api.github.com/repos/{owner}/{repo}/actions/jobs/{job}"
			],
			"ids": [
				"{owner}/{repo}/actions/jobs/{job}"
			],
			"reads": {
				"job": {
					"tool": "actions_get",
