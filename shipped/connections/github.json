	"objects": {
		"pull_request": {
			"card": "pull-request",
			"normalize": {
				"owner": "lowercase",
				"repo": "lowercase",
				"number": "integer"
			},
			"name": "{owner}/{repo} #{number}",
			"urls": [
				"https://github.com/{owner}/{repo}/pull/{number}",
				"https://api.github.com/repos/{owner}/{repo}/pulls/{number}"
			],
			"ids": [
				"{owner}/{repo}#{number}"
			],
			"reads": {
				"pr": {
					"tool": "pull_request_read",
					"args": {
						"method": "get",
						"owner": "{owner}",
						"repo": "{repo}",
						"pullNumber": "{number}"
					}
				},
				"checks": {
					"optional": true,
					"tool": "pull_request_read",
					"args": {
						"method": "get_check_runs",
						"owner": "{owner}",
						"repo": "{repo}",
						"pullNumber": "{number}",
						"perPage": 100,
						"page": 1
					}
				},
				"reviews": {
					"optional": true,
					"tool": "pull_request_read",
					"args": {
						"method": "get_reviews",
						"owner": "{owner}",
						"repo": "{repo}",
						"pullNumber": "{number}",
						"perPage": 100
					},
					"tail": {
						"by": "id"
					}
				},
				"comments": {
					"optional": true,
					"follow": true,
					"tool": "pull_request_read",
					"args": {
						"method": "get_comments",
						"owner": "{owner}",
						"repo": "{repo}",
						"pullNumber": "{number}",
						"perPage": 100
					},
					"tail": {
						"by": "id",
						"total": "pr.comments"
					}
				}
			},
			"follow": {
				"keys": {
					"checks.check_runs": "name"
				},
				"totals": {
					"checks.check_runs": "checks.total_count"
				},
				"ignore": [
					"pr.updated_at",
					"pr.comments",
					"pr.commits",
					"pr.changed_files",
					"pr.mergeable",
					"pr.mergeable_state",
					"checks.total_count",
					"checks.check_runs[*].id",
					"checks.check_runs[*].html_url",
					"checks.check_runs[*].details_url",
					"checks.check_runs[*].started_at",
					"checks.check_runs[*].completed_at",
					"checks.check_runs[*].check_suite",
					"checks.check_runs[*].app",
					"checks.check_runs[*].output",
					"reviews[*].html_url",
					"reviews[*].user.avatar_url",
					"reviews[*].user.profile_url",
					"reviews[*].submitted_at",
					"comments[*].html_url",
					"comments[*].user.avatar_url",
					"comments[*].user.profile_url",
					"comments[*].reactions",
					"comments[*].updated_at"
				],
				"authors": {
					"reviews": "user.login",
					"comments": "user.login"
				},
				"derived": {
					"checks_done": {
						"when": "all checks.check_runs[*].status = completed",
						"steady": "pr.head.sha"
					},
					"checks_green": {
						"when": "all checks.check_runs[*].conclusion = success|skipped|neutral",
						"steady": "pr.head.sha"
					}
				},
				"rules": [
					{
						"on": "pr.merged",
						"to": true,
						"does": "wake",
						"says": "merged"
					},
					{
						"on": "pr.state",
						"to": "closed",
						"does": "wake",
						"says": "closed"
					},
					{
						"on": "pr.state",
						"to": "open",
						"does": "wake",
						"says": "reopened"
					},
					{
						"on": "pr.draft",
						"to": false,
						"does": "wake",
						"says": "ready for review"
					},
					{
						"on": "pr.title",
						"does": "tell",
						"says": "retitled: {to}"
					},
					{
						"on": "checks.check_runs[*].conclusion",
						"to": "failure",
						"does": "wake",
						"says": "{name} failed"
					},
					{
						"on": "checks.check_runs[*].conclusion",
						"to": "timed_out",
						"does": "wake",
						"says": "{name} timed out"
					},
					{
						"on": "derived.checks_green",
						"to": true,
						"does": "wake",
						"says": "all checks green"
					},
					{
						"on": "derived.checks_done",
						"to": true,
						"does": "tell",
						"says": "checks finished"
					},
					{
						"on": "reviews[*]",
						"kind": "added",
						"does": "wake",
						"says": "{user.login} {state}",
						"words": {
							"APPROVED": "approved",
							"CHANGES_REQUESTED": "requested changes",
							"COMMENTED": "reviewed",
							"DISMISSED": "dismissed a review",
							"PENDING": "started a review"
						}
					},
					{
						"on": "reviews[*].state",
						"to": "DISMISSED",
						"does": "tell",
						"says": "{user.login}'s review was dismissed"
					},
					{
						"on": "comments[*]",
						"kind": "added",
						"does": "wake",
						"says": "{user.login} commented"
					},
					{
						"on": "checks.check_runs[*]",
						"kind": "added",
						"where": "conclusion = failure",
						"does": "wake",
						"says": "{name} failed"
					},
					{
						"on": "checks.check_runs[*]",
						"kind": "added",
						"where": "conclusion = timed_out",
						"does": "wake",
						"says": "{name} timed out"
					},
					{
						"on": "pr.head.sha",
						"does": "tell",
						"says": "new commits"
					}
				],
				"ends": {
					"merged": "pr.merged = true",
					"closed": "pr.state = closed"
				},
				"busy": "checks.check_runs[*].status != completed",
				"every": "5m",
				"settle": "1m"
			},
			"fields": {
				"number": "pr.number",
				"title": "pr.title",
				"state": "pr.state",
				"merged": "pr.merged",
				"draft": "pr.draft",
				"author": "pr.user",
				"branch": "pr.head.ref",
				"added": "pr.additions",
				"removed": "pr.deletions",
				"url": "pr.html_url",
				"checks": "checks.check_runs",
				"checks_total": "checks.total_count",
				"reviews": "reviews"
			},
			"writes": [
				{
					"tool": "add_issue_comment",
					"id": {
						"owner": "owner",
						"repo": "repo",
						"number": "issue_number"
					},
					"verb": "Comment",
					"what": "Comment on",
					"text": "body"
				},
				{
					"tool": "merge_pull_request",
					"id": {
						"owner": "owner",
						"repo": "repo",
						"number": "pullNumber"
					},
					"verb": "Merge"
				},
				{
					"tool": "pull_request_review_write",
					"id": {
						"owner": "owner",
						"repo": "repo",
						"number": "pullNumber"
					},
					"verb": "Review",
					"text": "body",
					"verbs": [
						{
							"when": {
								"event": "APPROVE"
							},
							"verb": "Approve"
						},
						{
							"when": {
								"event": "REQUEST_CHANGES"
							},
							"verb": "Request changes",
							"what": "Request changes on"
						}
					]
				},
				{
					"tool": "update_pull_request",
					"id": {
						"owner": "owner",
						"repo": "repo",
						"number": "pullNumber"
					},
					"verb": "Change",
					"verbs": [
						{
							"when": {
								"state": "closed"
							},
							"verb": "Close"
						},
						{
							"when": {
								"state": "open"
							},
							"verb": "Reopen"
						}
					]
				}
			]
		},
		"issue": {
			"card": "issue",
			"normalize": {
				"owner": "lowercase",
				"repo": "lowercase",
				"number": "integer"
			},
			"name": "{owner}/{repo} #{number}",
			"urls": [
				"https://github.com/{owner}/{repo}/issues/{number}",
				"https://api.github.com/repos/{owner}/{repo}/issues/{number}"
			],
			"ids": [
				"{owner}/{repo}#{number}"
			],
			"reads": {
				"issue": {
					"tool": "issue_read",
					"args": {
						"method": "get",
						"owner": "{owner}",
						"repo": "{repo}",
						"issue_number": "{number}"
					}
				},
				"comments": {
					"optional": true,
					"follow": true,
					"tool": "issue_read",
					"args": {
						"method": "get_comments",
						"owner": "{owner}",
						"repo": "{repo}",
						"issue_number": "{number}",
						"perPage": 100
					},
					"tail": {
						"by": "id",
						"total": "issue.comments"
					}
				}
			},
			"follow": {
				"ignore": [
					"issue.updated_at",
					"issue.comments",
					"issue.reactions",
					"issue.closed_at",
					"issue.closed_by",
					"issue.user.avatar_url",
					"issue.user.profile_url",
					"comments[*].html_url",
					"comments[*].user.avatar_url",
					"comments[*].user.profile_url",
					"comments[*].reactions",
					"comments[*].updated_at"
				],
				"authors": {
					"comments": "user.login"
				},
				"rules": [
					{
						"on": "issue.state",
						"to": "closed",
						"does": "wake",
						"says": "closed"
					},
					{
						"on": "issue.state",
						"to": "open",
						"does": "wake",
						"says": "reopened"
					},
					{
						"on": "comments[*]",
						"kind": "added",
						"does": "wake",
						"says": "{user.login} commented"
					},
					{
						"on": "issue.labels[*]",
						"kind": "added",
						"does": "tell",
						"says": "labelled {to}"
					},
					{
						"on": "issue.labels[*]",
						"kind": "removed",
						"does": "tell",
						"says": "unlabelled {from}"
					},
					{
						"on": "issue.assignees[*]",
						"kind": "added",
						"does": "tell",
						"says": "assigned to {to}"
					},
					{
						"on": "issue.assignees[*]",
						"kind": "removed",
						"does": "tell",
						"says": "unassigned {from}"
					},
					{
						"on": "issue.title",
						"does": "tell",
						"says": "retitled: {to}"
					}
				],
				"ends": {
					"closed": "issue.state = closed"
				},
				"every": "10m",
				"settle": "1m"
			},
			"fields": {
				"number": "issue.number",
				"title": "issue.title",
				"state": "issue.state",
				"reason": "issue.state_reason",
				"author": "issue.user",
				"labels": "issue.labels",
				"comments": "issue.comments",
				"assignees": "issue.assignees",
				"url": "issue.html_url"
			},
			"writes": [
				{
					"tool": "add_issue_comment",
					"id": {
						"owner": "owner",
						"repo": "repo",
						"number": "issue_number"
					},
					"verb": "Comment",
					"what": "Comment on",
					"text": "body"
				},
				{
					"tool": "issue_write",
					"id": {
						"owner": "owner",
						"repo": "repo",
						"number": "issue_number"
					},
					"verb": "Change",
					"text": "body",
					"verbs": [
						{
							"when": {
								"state": "closed",
								"state_reason": "not_planned"
							},
							"verb": "Close",
							"what": "Close as not planned"
						},
