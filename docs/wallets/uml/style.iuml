' Shared look for every wallet diagram (included by each .puml).
skinparam shadowing false
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam ArrowColor #3A3A3A
skinparam ArrowFontSize 11
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B8A040
skinparam NoteFontSize 11
skinparam TitleFontSize 15
skinparam LegendBackgroundColor #F6F6F6
skinparam LegendBorderColor #9A9A9A
skinparam LegendFontSize 10
skinparam ParticipantBackgroundColor #EEF3FA
skinparam ParticipantBorderColor #4F6D8F
skinparam ActorBorderColor #4F6D8F
skinparam DatabaseBackgroundColor #F2EEE3
skinparam DatabaseBorderColor #7A6A40
skinparam SequenceGroupBodyBackgroundColor #FFFFFF
skinparam SequenceDividerBackgroundColor #E8E8E8
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 320
skinparam StateBackgroundColor #EEF3FA
skinparam StateBorderColor #4F6D8F
skinparam ComponentBackgroundColor #EEF3FA
skinparam ComponentBorderColor #4F6D8F
skinparam NodeBackgroundColor #FAFAFA
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #4F6D8F
skinparam PackageBorderColor #7F7F7F
skinparam ActivityBackgroundColor #EEF3FA
skinparam ActivityBorderColor #4F6D8F
skinparam ActivityDiamondBackgroundColor #FFF8DC
skinparam UsecaseBackgroundColor #EEF3FA
skinparam UsecaseBorderColor #4F6D8F
skinparam state<<terminal>> {
  BackgroundColor #E6E6E6
  BorderColor #555555
}
